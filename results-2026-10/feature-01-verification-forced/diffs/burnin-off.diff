+using Microsoft.EntityFrameworkCore;
+using ReportsApi.Data;
+using ReportsApi.Models;
+
+namespace ReportsApi.Services;
+
+public enum ExtendError
+{
+    NotFound,
+    NotConfirmed,
+    NotAfterCurrentEnd,
+    ExceedsMaxDuration,
+    Overlap,
+}
+
+public record ExtendResult(Booking? Booking, ExtendError? Error, string? Message)
+{
+    public bool Succeeded => Error is null;
+}
+
+public class BookingExtensionService
+{
+    public static readonly TimeSpan MaxDuration = TimeSpan.FromHours(8);
+
+    private readonly ReportsDbContext _db;
+
+    public BookingExtensionService(ReportsDbContext db)
+    {
+        _db = db;
+    }
+
+    public async Task<ExtendResult> ExtendAsync(string id, DateTime newEndsAtUtc)
+    {
+        var booking = await _db.Bookings.FirstOrDefaultAsync(b => b.Id == id);
+        if (booking is null)
+            return Fail(ExtendError.NotFound, $"Booking '{id}' not found.");
+
+        if (booking.Status != "CONFIRMED")
+            return Fail(ExtendError.NotConfirmed, "Only CONFIRMED bookings can be extended.");
+
+        // SQLite hands DateTimes back as Unspecified; everything stored is UTC.
+        var startsAt = AsUtc(booking.StartsAt);
+        var endsAt = AsUtc(booking.EndsAt);
+
+        if (newEndsAtUtc <= endsAt)
+            return Fail(ExtendError.NotAfterCurrentEnd, "newEndsAt must be strictly after the current EndsAt.");
+
+        if (newEndsAtUtc - startsAt > MaxDuration)
+            return Fail(ExtendError.ExceedsMaxDuration, "Total booking duration must not exceed 8 hours.");
+
+        // Compared in memory: SQLite stores DateTime as text, so keep the
+        // half-open overlap check out of the translated query.
+        var others = await _db.Bookings
+            .Where(b => b.RoomId == booking.RoomId && b.Id != booking.Id && b.Status == "CONFIRMED")
+            .ToListAsync();
+
+        var conflict = others.Any(o => startsAt < AsUtc(o.EndsAt) && newEndsAtUtc > AsUtc(o.StartsAt));
+        if (conflict)
+            return Fail(ExtendError.Overlap, "The extended range overlaps another CONFIRMED booking in this room.");
+
+        booking.EndsAt = newEndsAtUtc;
+        await _db.SaveChangesAsync();
+        return new ExtendResult(booking, null, null);
+    }
+
+    private static DateTime AsUtc(DateTime value) =>
+        value.Kind == DateTimeKind.Utc ? value : DateTime.SpecifyKind(value, DateTimeKind.Utc);
+
+    private static ExtendResult Fail(ExtendError error, string message) => new(null, error, message);
+}
